    "placeholders": {
      "bearing": {
        "type": "int",
        "example": "92"
      }
    }
  },
  "@pointingTo": {
    "placeholders": {
      "direction": {
        "type": "String",
        "example": "SE"
      }
    }
  },
  "@pushBodyAlertNearby": {
    "placeholders": {
      "distance": {
        "type": "String",
        "example": "0.8 mi"
      }
    }
  },
  "@cloudCover": {
    "placeholders": {
      "percent": {
        "type": "int",
        "example": "63"
      }
    }
  },
  "@wind": {
    "placeholders": {
      "speed": {
        "type": "num",
        "example": "12.4"
      },
      "unit": {
        "type": "String",
        "example": "mph"
      }
    }
  },
  "@timeDaysAgo": {
    "placeholders": {
      "count": {
        "type": "int",
        "example": "2"
      }
    }
  },
